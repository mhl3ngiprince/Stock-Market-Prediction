# ---- Stock prediction configuration ----
STOCK_TICKERS=AAPL,MSFT,TSLA,NVDA
STOCK_BENCHMARK=SPY
STOCK_DAYS=1500
STOCK_EPOCHS=25
STOCK_WINDOW=60
STOCK_HORIZON=1
STOCK_TEST_SPLIT=0.2
STOCK_TXN_COST=0.0005
STOCK_SEED=42

# auto (LSTM if TensorFlow present, else gradient boosting) | lstm | gbdt
STOCK_BACKEND=auto

STOCK_DB_PATH=market.db
STOCK_PLOT_DIR=plots
STOCK_EXPORT_DIR=exports

STOCK_API_HOST=127.0.0.1
STOCK_API_PORT=8002
